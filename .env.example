# Contoh konfigurasi lokal. Salin ke .env, isi nilai, jangan commit .env.
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Database: file:./data/pam.db (lokal) atau libsql://... (Turso)
DATABASE_URL=file:./data/pam.db
DATABASE_AUTH_TOKEN=

# Auth
JWT_SECRET=isi-secret-lokal-minimal-32-karakter
JWT_ISSUER=pam
JWT_AUDIENCE=pam-android
ACCESS_TOKEN_TTL_SECONDS=3600
REGISTRATION_INVITE_CODE=pam-dev

# Enkripsi data at-rest (budget plan, token Gmail)
DATA_ENCRYPTION_KEY=base64-32-byte-key
DATA_KEY_VERSION=1

# Azure Foundry (kategorisasi)
CATEGORY_LLM_ENABLED=false
CATEGORY_LLM_PROVIDER=azure
AZURE_CLASSIFIER_BASE_URL=
AZURE_CLASSIFIER_API_KEY=
AZURE_CLASSIFIER_DEPLOYMENT=
AZURE_CLASSIFIER_MODEL=
AZURE_CLASSIFIER_REGION=
CATEGORY_LLM_DAILY_CEILING_USD=0.50
CATEGORY_LLM_MONTHLY_CEILING_USD=5.00

# Gmail API — polling default (tanpa Pub/Sub); push opt-in lewat GMAIL_MODE=push.
# Lihat docs/GMAIL_API_SETUP.md. Nonaktif secara default.
GMAIL_ENABLED=false
GMAIL_MODE=polling
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
# Delta otomatis >=900 detik; cooldown manual sync 60 detik.
GMAIL_DELTA_INTERVAL_SECONDS=900
GMAIL_SYNC_COOLDOWN_SECONDS=60
GMAIL_WORKER_INTERVAL_SECONDS=60
GMAIL_PAGE_SIZE=50
GMAIL_MAX_PAGES_PER_RUN=5
GMAIL_BACKFILL_MONTHS=12
# Opsional: GMAIL_APP_DEEP_LINK=pam://gmail/connected
# Hanya untuk Android UAT lokal (APP_ENV=development/uat-local): izinkan redirect
# http://127.0.0.1:<port>/v1/gmail/connect/callback dengan port bebas.
GMAIL_ALLOW_LOOPBACK_REDIRECT=false
# UAT tanpa akun Google (DEV ONLY, jangan dipakai produksi):
# GMAIL_PROVIDER=fake GMAIL_DEV_FIXTURE_FILE=/path/di/luar/repo/fixture.json
# GMAIL_DEV_SCENARIO=normal|history_expired|rate_limit
# Hanya untuk GMAIL_MODE=push (rollback):
# GMAIL_PUBSUB_TOPIC= GMAIL_PUSH_AUDIENCE= GMAIL_PUSH_SERVICE_ACCOUNT=

# Google SSO (ID token dari Android; Web Client ID, bukan client secret).
# Lihat docs/GOOGLE_SSO_CONTRACT.md. Nonaktif secara default: semua endpoint
# /v1/auth/google* menjawab 503 google_sso_disabled.
GOOGLE_SSO_ENABLED=false
GOOGLE_SSO_CLIENT_ID=
# Opsional; default https://www.googleapis.com/oauth2/v3/certs.
# Override http hanya diizinkan untuk APP_ENV=development dengan host loopback
# (dipakai test lokal), selain itu wajib HTTPS.
# GOOGLE_SSO_JWKS_URL=
# Masa berlaku nonce, 60..3600 detik (default 600).
GOOGLE_SSO_NONCE_TTL_SECONDS=600
