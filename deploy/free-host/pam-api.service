[Unit]
Description=PAM API (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pam
Group=pam
WorkingDirectory=/var/lib/pam-api
EnvironmentFile=/etc/pam/pam-api.env
ExecStart=/opt/pam-api/pam-api
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pam-api
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
